---
import Layout from '../layouts/Layout.astro';

const cases = [
  {
    title: 'SaaS Surge',
    result: '+312% organic traffic • 12 keywords in top 3',
    story:
      'A B2B SaaS company was stuck on page 4 for their most valuable terms. Through Scouting Jutsu, Code Ninjutsu, and consistent Alliance Forging, they dominated their category in under six months and became the recognized authority in their niche.',
  },
  {
    title: 'E-com Empire',
    result: '4.2× revenue from organic • #1 for primary money keywords',
    story:
      'An e-commerce brand needed to expand from local to national visibility. We combined Territory Domination with Story Arc Mastery to own both local map packs and competitive national SERPs, driving a dramatic increase in organic revenue.',
  },
  {
    title: 'Content Dojo',
    result: '50+ pages ranking on page 1 • Domain authority +28',
    story:
      'A new content site started from zero. We built topical authority through carefully planned pillar pages and supporting clusters. Within a year the site became a recognized industry resource with dozens of page-one rankings.',
  },
];
---

<Layout
  title="Ranking Legends | Shinobi SEO Case Studies"
  description="Real battles. Real results. See how Shinobi SEO helped brands claim the top spots with massive organic traffic growth."
>
  <section class="py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="font-bangers text-5xl md:text-6xl mb-4">
          Ranking <span class="text-anime-pink">Legends</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Real battles. Real results. See how we helped brands claim the top spots.
        </p>
      </div>

      <div class="space-y-10">
        {cases.map((c) => (
          <article class="bg-anime-panel border-4 border-black rounded-2xl p-8 shadow-[8px_8px_0_#00F5FF] hover:shadow-[8px_8px_0_#FF2D55] transition-shadow">
            <h2 class="font-bangers text-3xl text-anime-cyan mb-2">{c.title}</h2>
            <p class="text-anime-yellow font-bold text-sm uppercase tracking-wider mb-4">
              {c.result}
            </p>
            <p class="text-gray-300 leading-relaxed">{c.story}</p>
          </article>
        ))}
      </div>

      <div class="text-center mt-16">
        <a
          href="/contact"
          class="inline-block px-10 py-5 bg-anime-cyan text-anime-dark font-bangers text-2xl rounded-xl border-4 border-black shadow-[6px_6px_0_#FF2D55] hover:shadow-[3px_3px_0_#FF2D55] hover:translate-x-1 hover:translate-y-1 transition-all"
        >
          Become the Next Legend
        </a>
      </div>
    </div>
  </section>
</Layout>
