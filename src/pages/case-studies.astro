---
import Layout from '../layouts/Layout.astro';

const missions = [
  {
    title: 'Local shop, one city',
    result: 'Territory Domination',
    story:
      'A single-location service brand in Metro Manila or Cebu. We clean Google Business Profile, match the live offer to Maps categories, and fix the service pages people actually land on. No national keyword fantasy.',
  },
  {
    title: 'Multi-branch or ecommerce',
    result: 'Code Ninjutsu + Story Arc Mastery',
    story:
      'Catalogue or multi-city brands. We separate indexation problems from thin content, then write only the pages that have a real product or service behind them.',
  },
  {
    title: 'Content that has to survive QA',
    result: 'Full Status Scan',
    story:
      'Sites that already publish a lot and still do not rank. We inspect live pages, kill duplicate topics, and only keep articles with sources, internal links and a commercial next step. Same bar Bright Forge uses for client content.',
  },
];
---

<Layout
  title="SEO Missions | Shinobi SEO Philippines"
  description="How Shinobi SEO runs local, national and content missions in the Philippines. Honest process, no invented case-study numbers."
>
  <section class="py-20 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="font-bangers text-5xl md:text-6xl mb-4">
          Mission <span class="text-anime-pink">types</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          These are the fights we take. Named client scores wait until we have permission to publish them.
        </p>
      </div>

      <div class="space-y-10">
        {missions.map((c) => (
          <article class="bg-anime-panel border-4 border-black rounded-2xl p-8 shadow-[8px_8px_0_#00F5FF] hover:shadow-[8px_8px_0_#FF2D55] transition-shadow">
            <h2 class="font-bangers text-3xl text-anime-cyan mb-2">{c.title}</h2>
            <p class="text-anime-yellow font-bold text-sm uppercase tracking-wider mb-4">
              {c.result}
            </p>
            <p class="text-gray-300 leading-relaxed">{c.story}</p>
          </article>
        ))}
      </div>

      <div class="text-center mt-16">
        <a
          href="/contact"
          class="inline-block px-10 py-5 bg-anime-cyan text-anime-dark font-bangers text-2xl rounded-xl border-4 border-black shadow-[6px_6px_0_#FF2D55] hover:shadow-[3px_3px_0_#FF2D55] hover:translate-x-1 hover:translate-y-1 transition-all"
        >
          Brief a Mission
        </a>
      </div>
    </div>
  </section>
</Layout>
