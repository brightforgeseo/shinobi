---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    title: 'Keyword Research',
    mangaName: 'Scouting Jutsu',
    description:
      'We map high-intent keywords for SEO services in the Philippines: Taglish queries, city modifiers, and commercial pages that can actually convert. Thin topics get held, not padded.',
    icon: '🔍',
  },
  {
    title: 'On-Page SEO',
    mangaName: 'Page Power Form',
    description:
      'Headings, internal links, meta and offer language checked on the live page. We do not invent H1s that repeat the title for the sake of a checklist.',
    icon: '📄',
  },
  {
    title: 'Technical SEO',
    mangaName: 'Code Ninjutsu',
    description:
      'Indexation, speed, crawl paths, schema that matches visible content. Mobile-first Philippine search punishes slow, blocked, or duplicated templates.',
    icon: '⚙️',
  },
  {
    title: 'Local SEO Philippines',
    mangaName: 'Territory Domination',
    description:
      'Google Business Profile, Maps categories, NAP consistency, reviews and city landing pages for Manila, Cebu, Davao and service-area brands.',
    icon: '🗺️',
  },
  {
    title: 'Content Strategy',
    mangaName: 'Story Arc Mastery',
    description:
      'Articles and service pages written as we, with sources, varied internal links and a real next step. No synonym cycling. No fake thought-leadership.',
    icon: '✍️',
  },
  {
    title: 'SEO Audits and reporting',
    mangaName: 'Full Status Scan',
    description:
      'A ranked plan from live evidence. Reporting follows Bright Forge standards: what moved, what is blocked, what we will not claim.',
    icon: '📊',
  },
];
---

<Layout
  title="SEO Services Philippines | Shinobi SEO Techniques"
  description="SEO services in the Philippines from Shinobi SEO: local SEO, technical SEO, on-page, content and audits. A studio of Bright Forge SEO."
>
  <section class="py-20 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h1 class="font-bangers text-5xl md:text-6xl mb-4">
          SEO services <span class="text-anime-cyan">Philippines</span>
        </h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          Six techniques. Used only when the site and the city earn them. Parent method from Bright Forge SEO.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>

      <div class="text-center">
        <a
          href="/contact"
          class="inline-block px-10 py-5 bg-anime-pink text-white font-bangers text-2xl rounded-xl border-4 border-black shadow-[6px_6px_0_#00F5FF] hover:shadow-[3px_3px_0_#00F5FF] hover:translate-x-1 hover:translate-y-1 transition-all"
        >
          Begin Your Training
        </a>
      </div>
    </div>
  </section>
</Layout>
