---
import Layout from '../layouts/Layout.astro';
import SpeechBubble from '../components/SpeechBubble.astro';
---

<Layout
  title="Contact Shinobi SEO | SEO Agency Philippines"
  description="Contact Shinobi SEO in Quezon City for SEO services in the Philippines. A studio of Bright Forge SEO."
>
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center mb-12">
      <h1 class="font-bangers text-5xl md:text-6xl mb-4">
        Summon the <span class="text-anime-pink">dojo</span>
      </h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Quezon City based. Missions across the Philippines. Parent company:
        <a href="https://brightforgeseo.com" class="text-anime-cyan underline underline-offset-4 hover:text-anime-pink">Bright Forge SEO</a>.
      </p>
    </div>

    <div class="max-w-xl mx-auto mb-12">
      <SpeechBubble
        text="Send the site, the city, and the offer. We reply within one working day. No fake ranking guarantees."
        author="Shinobi SEO"
      />
    </div>

    <form
      class="max-w-xl mx-auto space-y-6"
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
    >
      <div>
        <label for="name" class="block font-bold text-anime-cyan mb-2">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-3 bg-anime-panel border-4 border-black rounded-lg text-white focus:border-anime-pink outline-none transition"
        />
      </div>
      <div>
        <label for="email" class="block font-bold text-anime-cyan mb-2">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-3 bg-anime-panel border-4 border-black rounded-lg text-white focus:border-anime-pink outline-none transition"
        />
      </div>
      <div>
        <label for="website" class="block font-bold text-anime-cyan mb-2">Website URL</label>
        <input
          type="url"
          id="website"
          name="website"
          class="w-full px-4 py-3 bg-anime-panel border-4 border-black rounded-lg text-white focus:border-anime-pink outline-none transition"
        />
      </div>
      <div>
        <label for="message" class="block font-bold text-anime-cyan mb-2">
          City, offer, and what is stuck
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="w-full px-4 py-3 bg-anime-panel border-4 border-black rounded-lg text-white focus:border-anime-pink outline-none transition"
        ></textarea>
      </div>
      <button
        type="submit"
        class="w-full px-8 py-4 bg-anime-pink text-white font-bangers text-2xl rounded-xl border-4 border-black shadow-[6px_6px_0_#00F5FF] hover:shadow-[3px_3px_0_#00F5FF] hover:translate-x-1 hover:translate-y-1 transition-all"
      >
        Launch the Mission
      </button>
    </form>
  </section>
</Layout>
